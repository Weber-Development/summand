{
  "name": "summand-monorepo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "pnpm -r --filter './packages/**' run test",
    "check:packages": "attw --pack packages/core --profile node16",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "rules": "pnpm --filter @sweberdev/summand run rules",
    "schemas": "pnpm --filter @sweberdev/summand run schemas",
    "changeset": "changeset",
    "release": "pnpm build && pnpm check:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^2.29.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "^0.27.7"
    }
  }
}
